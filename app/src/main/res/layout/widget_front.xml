<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No front"
        android:textColor="#FFD6AC5E"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/w_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="Ninguém no front"
        android:textColor="#FFECECEE"
        android:textSize="17sp" />
    <TextView
        android:id="@+id/w_since"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="toque para registrar"
        android:textColor="#FFA0A3AB"
        android:textSize="11sp" />
</LinearLayout>
